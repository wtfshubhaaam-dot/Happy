# ---- Required (the ONLY things configured here; everything else is set from the bot's admin panel) ----
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
OWNER_ID=123456789
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority
# Needed for Stream mode (get them at https://my.telegram.org) + BASE_URL = your public https URL, no trailing slash
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
BASE_URL=https://your-app-name.koyeb.app

# ---- Permanent links (Cloudflare Worker, see cloudflare-worker/worker.js) ----
WORKER_URL=https://your-worker.your-name.workers.dev
WORKER_SECRET=same-long-random-text-as-in-the-worker

# ---- Optional ----
DB_NAME=filesharebot
PORT=8080
LOG_LEVEL=INFO
PAD_WIDTH=34

# ---- Multi-server mode (several free Koyeb accounts, ONE bot, ONE database). Leave CLUSTER_SECRET empty for a single server.
# Same BOT_TOKEN / MONGO_URI / API_ID / API_HASH / OWNER_ID on every server. Only these 3 differ per server:
#   NODE_ID=n1  NODE_ROLE=gateway  BASE_URL=https://app-one.koyeb.app      (exactly ONE gateway)
#   NODE_ID=n2  NODE_ROLE=worker   BASE_URL=https://app-two.koyeb.app      (n3, n4 ... for more)
CLUSTER_SECRET=
NODE_ID=
NODE_ROLE=worker
NODE_NAME=
NODE_CAPACITY=30
NODE_MAX_TASKS=20
ACTIVE_WINDOW=300
# NODE_NAME = the name users see, e.g. "🔥 Phoenix". Empty = picked from NODE_ID (n1 Falcon, n2 Phoenix, n3 Thunder, n4 Dragon...).
# On Render / Koyeb BASE_URL may be left empty: the platform's own URL is used. Servers can be on different platforms.

# ---- One domain for all servers (Cloudflare Worker in front, see cloudflare-worker/README.md) ----
# PUBLIC_URL=https://hubpa.com

# ---- Multi-server hardening (optional) ----
# NODE_ROLE=gateway on TWO servers = active + standby (automatic failover, decided by a lease in MongoDB).
# CLUSTER_SECRET must be at least 24 characters:  openssl rand -hex 32
# NODE_HARD_TASKS=0        # real limit where a server answers 503 (0 = automatic: 4 x NODE_MAX_TASKS)
# NODE_HARD_STREAMS=0      # same for Stream/Download viewers (0 = automatic: 4 x NODE_MAX_STREAMS)
# DL_RATE_PER_10S=60       # per-IP limit for /dl/... (0 = off)
# ORIGIN_SECRET=           # same text as in the Cloudflare Worker (with PUBLIC_URL set the servers then refuse direct visitors)
# DRAIN_SECONDS=12         # on shutdown wait this long for running requests
# Health check path on Koyeb / Render: /healthz  (liveness, no database)

# Forward-only: no MTProto streaming/download endpoints.
LINK_RATE_PER_10S=60
